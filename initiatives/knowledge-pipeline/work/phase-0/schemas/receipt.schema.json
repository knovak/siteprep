{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-pipeline/v1/receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "operationId", "packageHash", "activityId", "createdAt", "mode", "createdHashes"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "operationId": {"type": "string", "minLength": 1},
    "packageHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "activityId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["restore", "merge", "copy", "migration"]},
    "createdHashes": {"type": "array", "items": {"type": "string"}}
  }
}
