{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siteprep.local/body-movement-visual-twin/movement.schema.json",
  "title": "Body Movement Visual Twin movement record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tradition",
    "title",
    "summary",
    "asset_manifest",
    "phases",
    "instruction",
    "variations",
    "safety",
    "source"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "tradition": { "enum": ["feldenkrais", "yoga", "alexander"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "asset_manifest": { "type": "string", "pattern": "^\\.\\./phase-0/.+\\.json$" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    },
    "instruction": { "type": "object" },
    "variations": {
      "type": "array",
      "items": { "$ref": "#/$defs/variation" }
    },
    "safety": { "$ref": "#/$defs/safety" },
    "source": { "$ref": "#/$defs/source" }
  },
  "allOf": [
    {
      "if": { "properties": { "tradition": { "const": "feldenkrais" } }, "required": ["tradition"] },
      "then": { "properties": { "instruction": { "$ref": "#/$defs/feldenkraisInstruction" } } }
    },
    {
      "if": { "properties": { "tradition": { "const": "yoga" } }, "required": ["tradition"] },
      "then": { "properties": { "instruction": { "$ref": "#/$defs/yogaInstruction" } } }
    },
    {
      "if": { "properties": { "tradition": { "const": "alexander" } }, "required": ["tradition"] },
      "then": { "properties": { "instruction": { "$ref": "#/$defs/alexanderInstruction" } } }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "timedCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "cue"],
      "properties": {
        "phase": { "$ref": "#/$defs/nonEmptyString" },
        "cue": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "t", "joint_actions", "muscles"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "t": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0 }
        },
        "joint_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["joint", "action"],
            "properties": {
              "joint": { "$ref": "#/$defs/nonEmptyString" },
              "action": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "muscles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "behaviour"],
            "properties": {
              "id": { "$ref": "#/$defs/nonEmptyString" },
              "behaviour": { "enum": ["shortens", "lengthens", "stabilises"] }
            }
          }
        }
      }
    },
    "variation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["range", "support", "side", "position"] },
        "note": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cautions", "expects_teacher", "notes"],
      "properties": {
        "cautions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "expects_teacher": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": { "enum": ["unreviewed", "reviewed", "disputed"] },
        "by": { "$ref": "#/$defs/nonEmptyString" },
        "on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["reviewed", "disputed"] } }, "required": ["status"] },
          "then": { "required": ["by", "on"] }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tradition_basis", "rights_basis", "authored_by", "authored_on", "review"],
      "properties": {
        "tradition_basis": { "$ref": "#/$defs/nonEmptyString" },
        "rights_basis": { "type": "string", "pattern": "^provisional:" },
        "authored_by": { "$ref": "#/$defs/nonEmptyString" },
        "authored_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "feldenkraisInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exploration", "attention", "range", "rest_pauses"],
      "properties": {
        "exploration": { "$ref": "#/$defs/nonEmptyString" },
        "attention": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/timedCue" }
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "smaller_reference"],
          "properties": {
            "kind": { "const": "optional" },
            "smaller_reference": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "rest_pauses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["after_phase", "duration_seconds", "note"],
            "properties": {
              "after_phase": { "$ref": "#/$defs/nonEmptyString" },
              "duration_seconds": { "type": "number", "minimum": 1 },
              "note": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "yogaInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "transitions", "modifications", "props"],
      "properties": {
        "posture": { "$ref": "#/$defs/nonEmptyString" },
        "transitions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase", "direction", "cue"],
            "properties": {
              "phase": { "$ref": "#/$defs/nonEmptyString" },
              "direction": { "enum": ["entry", "exit"] },
              "cue": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "modifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "note"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "note": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "props": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "alexanderInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity", "directions", "inhibition", "manual_guidance_boundary"],
      "properties": {
        "activity": { "$ref": "#/$defs/nonEmptyString" },
        "directions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/timedCue" }
        },
        "inhibition": { "$ref": "#/$defs/nonEmptyString" },
        "manual_guidance_boundary": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
