{
  "name": "educational-global-maps-portable-scene-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:app": "esbuild app/app.mjs --bundle --outfile=app/bundle.js --format=iife --platform=browser --target=es2022",
    "contributions": "node scripts/validate-contribution.mjs fixtures/contributions/owid-population fixtures/contributions/datacommons-income",
    "round-trip": "node scripts/round-trip.mjs",
    "test": "npm run build:app && node --test test/*.test.mjs",
    "test:browser": "npm run build:app && playwright test --config playwright.config.mjs"
  },
  "dependencies": {
    "d3-array": "3.2.4",
    "d3-geo": "3.1.1",
    "d3-geo-polygon": "2.0.1",
    "d3-geo-projection": "4.0.0",
    "fflate": "0.7.4"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "esbuild": "0.25.9"
  }
}
