# dev:local creates a fresh secret in ignored .dev.vars with owner-only permissions.
# Never use a checked-in example value for FLINGS_SECRET.
FLINGS_MODE=local
FLINGS_ORIGIN=http://localhost:5187
# FLINGS_SECRET=<generated random secret, at least 32 characters>

# Hosted private rehearsal values live in Sites environment settings, not here:
# FLINGS_MODE=private-test
# FLINGS_ORIGIN=https://flings-test.ken-novak.chatgpt.site
# Keep the Site owner-only. Each API request needs the Sites-dispatched user ID.

# Native organizer mode uses dispatcher identity and a server-side enrollment list:
# FLINGS_MODE=chatgpt
# FLINGS_ORIGIN=https://flings-test.ken-novak.chatgpt.site
# FLINGS_ORGANIZERS=[{"email":"organizer@example.invalid","name":"Example Organizer"}]
# Provision the approved accounts from decisions.md in Sites runtime settings.
# First explicit enrollment pins the Site-scoped identity; it grants no gathering access.
