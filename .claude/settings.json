{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__claude-code-remote__send_later",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__claude-code-remote__delete_trigger",
      "mcp__Claude_Code_Remote__delete_trigger",
      "mcp__claude-code-remote__list_triggers",
      "mcp__Claude_Code_Remote__list_triggers"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/trust-workspace.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__send_later",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"send_later is pre-approved in .claude/settings.json\"}}'"
          }
        ]
      }
    ]
  }
}
