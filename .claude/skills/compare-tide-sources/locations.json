      }
    },
    {
      "id": "inverness-ca",
      "query": "Inverness, California",
      "zone": "America/Los_Angeles",
      "expectProvider": "NOAA",
      "why": "Up a long narrow inlet (Tomales Bay). NOAA has a subordinate station that knows the bay lags the ocean by about 90 minutes; a global model has no inlet to lag in. Expect the largest timing gap in the set.",
      "official": {
        "kind": "noaa",
        "station": "9415228",
        "name": "Inverness, Tomales Bay",
        "datum": "MLLW",
        "url": "https://tidesandcurrents.noaa.gov/noaatidepredictions.html?id=9415228"
      }
    },
    {
      "id": "portland-me",
      "query": "Portland, Maine",
      "zone": "America/New_York",
      "expectProvider": "NOAA",
      "why": "Large-range Atlantic tide (3 m+) at an unambiguous NOAA primary station. Big absolute numbers make a percentage range error easy to see.",
      "official": {
        "kind": "noaa",
        "station": "8418150",
        "name": "Portland, Maine",
        "datum": "MLLW",
        "url": "https://tidesandcurrents.noaa.gov/noaatidepredictions.html?id=8418150"
      }
    },
    {
      "id": "vancouver-bc",
      "query": "Vancouver, Canada",
      "zone": "America/Vancouver",
      "expectProvider": "CHS",
      "why": "Exercises the Canadian CHS adapter, the third official provider. Mixed semidiurnal tide with unequal highs and lows, which is harder to match than a clean twice-daily curve.",
      "official": {
        "kind": "chs",
        "station": "07735",
        "name": "Vancouver",
        "datum": "Chart Datum",
        "url": "https://tides.gc.ca/en/stations/07735"
      }
    },
    {
      "id": "inverness-uk",
      "query": "Inverness, United Kingdom",
      "zone": "Europe/London",
      "expectProvider": "FES2022",
      "why": "No official adapter is configured for the UK, so both apps fall back to the same global model and should agree with each other exactly. UKHO is the outside check on that model.",
      "official": {
        "kind": "ukho",
        "station": "0256",
        "name": "Inverness",
        "datum": "Chart Datum",
        "url": "https://easytide.admiralty.co.uk/?PortID=0256"
      }
    },
    {
      "id": "nice-fr",
      "query": "Nice, France",
      "zone": "Europe/Paris",
      "expectProvider": "FES2022",
      "why": "Microtidal Mediterranean coast: the whole daily range is 10-25 cm. Percentage errors look alarming here and mean almost nothing, which is exactly why the range check needs an absolute floor as well as a percentage.",
      "official": {
        "kind": "shom",
        "station": "NICE",
        "name": "Nice",
        "datum": "Chart Datum",
        "url": "https://maree.shom.fr/harbor/NICE/hlt"
      }
    },
    {
      "id": "maroochydore-au",
      "query": "Maroochydore, Australia",
      "zone": "Australia/Brisbane",
